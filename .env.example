# AI: any OpenAI-compatible endpoint (here: NUS SoC's). Models benchmarked in README section 3.3
AI_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
# AI key: AI_API_KEY, or falls back to the SOCLAAS_API_KEY system env var
AI_CLASSIFIER_MODEL=qwen3.6:35b
AI_DIGEST_MODEL=qwen3.8:27b
AI_VISION_MODEL=qwen3.6:35b
# AI_FALLBACK_MODEL=qwen3.6:35b   (used when another model gives no answer in time; empty = never switch)

# Browser: empty = local Chromium (default); set to use Browserless later
BROWSER_WS_URL=
FALLBACK_AGENT=off

# TELEGRAM_BOT_TOKEN=   (from @BotFather; or set it as a user env var)
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=...
DATABASE_URL=sqlite:///data/mailbrief.db
DEFAULT_TIMEZONE=Asia/Singapore
# When `mailbrief serve` runs: "<days> <HH:MM> [scope]; …" e.g. "daily 07:30; sun 20:00 this-week" (see commands.md §7)
RUN_AT=daily 07:30
# MB: labels (categories) on your emails in Outlook: on | off (commands.md §5)
OUTLOOK_LABELS=on
RESTORE_UNREAD=true
ARCHIVE_DAYS=0
# Images linked from newsletters: downloaded for the AI with safety checks; their servers see your IP (off = don't)
REMOTE_IMAGES=on
# UPCOMING EVENTS message after each digest: days ahead (0 = don't send it)
EVENTS_DAYS=14
# Chat with your inbox in Telegram (serve answers your registered private chat): on | off (send-only)
CHAT=on
AI_EMBED_MODEL=bge-m3
AI_ANSWER_MODEL=qwen3.8:27b
# Signing in from your phone (/login, `mailbrief login --remote`): the link's address. Must be https:// unless
# localhost. Empty = Render's/Railway's own address (set for you), else http://localhost:$PORT
PUBLIC_URL=
# PORT=8080   (the sign-in page's port, listening only while a sign-in is open; Railway and Render set it)
# LOGIN_PAGE=always   (keep the port open, 404 except an open sign-in; automatic on Render, which requires a port)
# LOGIN_TUNNEL=cloudflared   (on your PC: /login opens a temporary https://….trycloudflare.com link for your phone.
#   Needs cloudflared installed. Cloudflare sees the page's traffic, your password included)
